# 複製成 server/.env 後修改；沒有設定的項目使用預設值。

# API 監聽的埠號
PORT=8787

# 資料庫：
#   不設定 → 本機開發用內嵌的 PGlite，資料存在 server/.data/pglite
#   postgres://user:password@host:5432/dbname → 正式環境的 PostgreSQL（例如 Neon）
# DATABASE_URL=

# 允許發出寫入請求的網頁網址，多個用逗號分隔；開發時預設 http://localhost:5173
# APP_ORIGINS=https://your-app.example.com

# 設成 production 時：cookie 只走 HTTPS、必須設定 DATABASE_URL，並由這個服務提供 dist/ 裡的網頁
# NODE_ENV=production

# 在反向代理後面時設成 1，才能用 X-Forwarded-For 取得使用者 IP（production 預設開啟）
# TRUST_PROXY=1

# 前端建置結果的位置（production 預設為專案根目錄的 dist/）
# STATIC_DIR=

# AI 講解回饋（Claude）：
#   不設定 → 停用，網頁上會顯示伺服器沒有開啟 AI 回饋
#   到 https://platform.claude.com 建立 API key 後填入
# ANTHROPIC_API_KEY=
# 每位使用者每天最多幾次（預設 20）
# AI_DAILY_LIMIT=20
