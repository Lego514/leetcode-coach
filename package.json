{
  "name": "leetcode-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "刷題教練：LeetCode 面試準備的學習路徑、間隔複習、筆記與模擬面試",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "npm run dev -w server",
    "build": "tsc -b && vite build",
    "build:server": "npm run build -w server",
    "start": "npm run start -w server",
    "preview": "vite preview",
    "test": "vitest run && npm test -w server",
    "test:watch": "vitest",
    "test:e2e": "npm run build:all && playwright test --project=chromium",
    "test:e2e:all": "npm run build:all && playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -b && npm run typecheck -w server",
    "build:all": "npm run build && npm run build:server"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  },
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=24"
  }
}
